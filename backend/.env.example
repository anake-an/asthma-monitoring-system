# Backend (Laravel) settings. Copy to backend/.env on the server and run:
#   docker compose exec backend php artisan key:generate
# Values passed by docker-compose.yaml (DB_*, MAIL_*, MQTT_*) override these.

APP_NAME=RespiroSync
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8005
# Where the dashboard is served: the links in invite, password-reset and alert emails
FRONTEND_URL=https://app.respirosync.online

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=asthma_db
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="RespiroSync"

# Broker account used by the API, MQTT worker and scheduler (see mosquitto/config/acl)
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=respirosync_backend
MQTT_PASSWORD=

AI_ENGINE_URL=http://ai_engine:8000

# Web Push (generate with: php artisan webpush:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required by Apple (iPhone pushes are rejected without it): a mailto: or https: address
VAPID_SUBJECT=mailto:you@example.com

# Cloud firmware updates: key GitHub Actions uses to upload new ESP32 builds (POST /api/firmware/upload).
# Empty = uploads off. Same value as the FIRMWARE_UPLOAD_TOKEN secret in GitHub. Make one with: openssl rand -hex 32
FIRMWARE_UPLOAD_TOKEN=
