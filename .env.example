# docker-compose variables. Copy to .env next to docker-compose.yaml (never commit it).

DB_USERNAME=respirosync
DB_PASSWORD=
DB_ROOT_PASSWORD=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Must match the respirosync_backend entry in mosquitto/config/passwd
MQTT_USERNAME=respirosync_backend
MQTT_PASSWORD=

CLOUDFLARE_TOKEN=
